# NAME: Jooan W3-U (T23N, SC2336P, ETH, ATBM6132U)
# FRAG: uboot/v2013-07 soc-xburst1 core uboot/recovery-bootcmd
BR2_ETHERNET=y
BR2_INGENIC_SOC_MODEL="t23n"
BR2_ISP_CLK_200MHZ=y
BR2_PACKAGE_THINGINO_KOPT_MMC0=y
BR2_PACKAGE_THINGINO_KOPT_MMC0_PB_4BIT=y
BR2_PACKAGE_WIFI=y
BR2_PACKAGE_WIFI_ATBM6132U=y
BR2_SENSOR_1_NAME="sc2336p"
BR2_THINGINO_AUDIO=y
BR2_THINGINO_BUTTON=y
BR2_THINGINO_MOTORS=y
BR2_THINGINO_SDCARD=y
FLASH_SIZE_MB=8

# Memory split optimized for single sensor (osmem 38M, rmem 26M)
BR2_THINGINO_RMEM_MB=26

# Watchdog + recovery
BR2_PACKAGE_BUSYBOX_WATCHDOG=y
BR2_PACKAGE_THINGINO_WATCHDOG=y

# Sensor auto-detection
BR2_PACKAGE_THINGINO_SENSOR_DETECT=y