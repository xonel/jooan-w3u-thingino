Subject: [PATCH] sc2336p family (t23): accept SC2336 (0xcb3a) and classic 0x10 chip IDs

Jooan W3-U dual-lens boards ship SC2336-family sensors that report either
classic SC2336/SC223A high byte 0x10 or standard SC2336 0xcb3a instead of
SC2336P 0x9b3a. Accept 0x9b, 0xcb, and 0x10 in sc2336p, sc2336ps0, and
sc2336ps1 so all variants probe cleanly.
---
--- a/3.10.14/sensor-src/t23/sc2336p.c
+++ b/3.10.14/sensor-src/t23/sc2336p.c
@@ -1016,7 +1016,7 @@ static int sensor_detect(struct tx_isp_subdev *sd, unsigned int *ident)
 	if (ret < 0)
 		return ret;
 
-	if (v != SENSOR_CHIP_ID_H)
+	if (v != SENSOR_CHIP_ID_H && v != 0xcb && v != 0x10)
 		return -ENODEV;
 
 	*ident = v;
@@ -1026,7 +1026,7 @@ static int sensor_detect(struct tx_isp_subdev *sd, unsigned int *ident)
 	if (ret < 0)
 		return ret;
 
-	if (v != SENSOR_CHIP_ID_L)
+	if (*ident != 0x10 && v != SENSOR_CHIP_ID_L)
 		return -ENODEV;
 
 	*ident = (*ident << 8) | v;
--- a/3.10.14/sensor-src/t23/sc2336ps0.c
+++ b/3.10.14/sensor-src/t23/sc2336ps0.c
@@ -616,7 +616,7 @@ static int sensor_detect(struct tx_isp_subdev *sd, unsigned int *ident)
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
 	if (ret < 0)
 		return ret;
-	if (v != SENSOR_CHIP_ID_H)
+	if (v != SENSOR_CHIP_ID_H && v != 0xcb && v != 0x10)
 		return -ENODEV;
 	*ident = v;
 
@@ -624,7 +624,7 @@ static int sensor_detect(struct tx_isp_subdev *sd, unsigned int *ident)
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
 	if (ret < 0)
 		return ret;
-	if (v != SENSOR_CHIP_ID_L)
+	if (*ident != 0x10 && v != SENSOR_CHIP_ID_L)
 		return -ENODEV;
 	*ident = (*ident << 8) | v;
 
--- a/3.10.14/sensor-src/t23/sc2336ps1.c
+++ b/3.10.14/sensor-src/t23/sc2336ps1.c
@@ -620,7 +620,7 @@ static int sensor_detect(struct tx_isp_subdev *sd, unsigned int *ident)
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
 	if (ret < 0)
 		return ret;
-	if (v != SENSOR_CHIP_ID_H)
+	if (v != SENSOR_CHIP_ID_H && v != 0xcb && v != 0x10)
 		return -ENODEV;
 	*ident = v;
 
@@ -628,7 +628,7 @@ static int sensor_detect(struct tx_isp_subdev *sd, unsigned int *ident)
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
 	if (ret < 0)
 		return ret;
-	if (v != SENSOR_CHIP_ID_L)
+	if (*ident != 0x10 && v != SENSOR_CHIP_ID_L)
 		return -ENODEV;
 	*ident = (*ident << 8) | v;
 
