Subject: [PATCH] sc2336p family: accept classic SC2336/SC223A chip id 0x10

The W3-U dual-lens camera reports chip id 0x10 (classic SC2336 family)
instead of the SC2336P signature 0x9b3a. Accept the 0x10 high byte
and skip the low byte check for that variant so the sensor detects.
---

--- a/3.10.14/sensor-src/t23/sc2336p.c	2026-09-13 03:14:54.072702367 +0200
+++ b/3.10.14/sensor-src/t23/sc2336p.c	2026-09-13 03:15:18.284974025 +0200
@@ -1016,7 +1016,7 @@
 	if (ret < 0)
 		return ret;
 
-	if (v != SENSOR_CHIP_ID_H)
+	if (v != SENSOR_CHIP_ID_H && v != 0x10)
 		return -ENODEV;
 
 	*ident = v;
@@ -1026,7 +1026,7 @@
 	if (ret < 0)
 		return ret;
 
-	if (v != SENSOR_CHIP_ID_L)
+	if (*ident != 0x10 && v != SENSOR_CHIP_ID_L)
 		return -ENODEV;
 
 	*ident = (*ident << 8) | v;
--- a/3.10.14/sensor-src/t23/sc2336ps0.c	2026-09-13 03:14:54.057563122 +0200
+++ b/3.10.14/sensor-src/t23/sc2336ps0.c	2026-09-13 03:14:59.848946140 +0200
@@ -616,7 +616,7 @@
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
 	if (ret < 0)
 		return ret;
-	if (v != SENSOR_CHIP_ID_H)
+	if (v != SENSOR_CHIP_ID_H && v != 0x10)
 		return -ENODEV;
 	*ident = v;
 
@@ -624,7 +624,7 @@
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
 	if (ret < 0)
 		return ret;
-	if (v != SENSOR_CHIP_ID_L)
+	if (*ident != 0x10 && v != SENSOR_CHIP_ID_L)
 		return -ENODEV;
 	*ident = (*ident << 8) | v;
 
--- a/3.10.14/sensor-src/t23/sc2336ps1.c	2026-09-13 03:14:54.065164375 +0200
+++ b/3.10.14/sensor-src/t23/sc2336ps1.c	2026-09-13 03:15:04.477953171 +0200
@@ -620,7 +620,7 @@
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
 	if (ret < 0)
 		return ret;
-	if (v != SENSOR_CHIP_ID_H)
+	if (v != SENSOR_CHIP_ID_H && v != 0x10)
 		return -ENODEV;
 	*ident = v;
 
@@ -628,7 +628,7 @@
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
 	if (ret < 0)
 		return ret;
-	if (v != SENSOR_CHIP_ID_L)
+	if (*ident != 0x10 && v != SENSOR_CHIP_ID_L)
 		return -ENODEV;
 	*ident = (*ident << 8) | v;
 
