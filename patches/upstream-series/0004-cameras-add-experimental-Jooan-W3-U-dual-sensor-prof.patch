+++ b/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/raptor.config
@@ -0,0 +1,17 @@
+RAPTOR_SENSOR0_NAME="cv2003"
+RAPTOR_SENSOR0_I2C_ADDR="0x35"
+RAPTOR_SENSOR0_WIDTH="1920"
+RAPTOR_SENSOR0_HEIGHT="1080"
+RAPTOR_SENSOR0_FPS="15"
+RAPTOR_SENSOR1_NAME="cv2003s1"
+RAPTOR_SENSOR1_I2C_ADDR="0x36"
+RAPTOR_SENSOR1_WIDTH="1920"
+RAPTOR_SENSOR1_HEIGHT="1080"
+RAPTOR_SENSOR1_FPS="15"
+RAPTOR_STREAM0_FPS="15"
+RAPTOR_STREAM1_FPS="15"
+RAPTOR_S1S0_FPS="15"
+RAPTOR_S1S1_FPS="15"
+RAPTOR_RTSP_ENDPOINT_S1_MAIN="ch2"
+RAPTOR_RTSP_ENDPOINT_S1_SUB="ch3"
+RAPTOR_OSD_ISP_OSD_TRUE=y
diff --git a/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/thingino.json b/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/thingino.json
