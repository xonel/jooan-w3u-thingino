diff --git a/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u_defconfig b/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u_defconfig
new file mode 100644
index 0000000..797d961
--- /dev/null
+++ b/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u_defconfig
@@ -0,0 +1,25 @@
+# NAME: Jooan W3-U (T23N, Dual CV2003, ETH, ATBM6132U)
+# FRAG: soc-xburst1 core
+BR2_ETHERNET=y
+BR2_INGENIC_SOC_MODEL="t23n"
+BR2_ISP_CLK_200MHZ=y
+BR2_ISP_DIRECT_MODE_0=y
+BR2_ISP_MEMOPT_0=y
+BR2_ISP_PARAMS="mipi_switch_gpio=7"
+BR2_PACKAGE_THINGINO_KOPT_MMC0=y
+BR2_PACKAGE_THINGINO_KOPT_MMC0_PB_4BIT=y
+BR2_PACKAGE_WIFI=y
+BR2_PACKAGE_WIFI_ATBM6132U=y
+BR2_SENSOR_1_NAME="cv2003s0"
+BR2_SENSOR_1_PARAMS="reset_gpio=18"
+BR2_SENSOR_2_NAME="cv2003s1"
+BR2_SENSOR_2_PARAMS="reset_gpio=16"
+BR2_THINGINO_AUDIO=y
+BR2_THINGINO_BUTTON=y
+BR2_THINGINO_IMAGE_SENSOR_QTY=2
+BR2_THINGINO_MOTORS=y
+BR2_THINGINO_PWM_ENABLE=y
+BR2_THINGINO_RMEM_MB=34
+BR2_THINGINO_SDCARD=y
+BR2_THINGINO_UBOOT_VERSION_2013_07=y
+FLASH_SIZE_MB=8
diff --git a/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/prudynt.json b/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/prudynt.json
new file mode 100644
index 0000000..44a6598
--- /dev/null
+++ b/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/prudynt.json
@@ -0,0 +1,13 @@
+{
+  "multi_sensor": {
+    "enabled": true,
+    "count": 2,
+    "mipi_switch_gpio": 7,
+    "sensors": {
+      "0": { "model": "cv2003s0", "gpio_reset": 18 },
+      "1": { "model": "cv2003s1", "gpio_reset": 16 }
+    }
+  },
+  "stream2": { "enabled": true, "video_enabled": true, "rtsp_endpoint": "ch2" },
+  "stream3": { "enabled": true, "video_enabled": true, "rtsp_endpoint": "ch3" }
+}
diff --git a/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/raptor.config b/configs/cameras/jooan_w3u_t23n_cv2003_dual_eth+atbm6132u/raptor.config
