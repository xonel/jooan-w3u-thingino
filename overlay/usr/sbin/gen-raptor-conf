#!/bin/sh
# gen-raptor-conf — Generate raptor.conf from detected sensor config
# Reads /etc/uenv.sensor (written by S10sensor-detect) and produces
# a raptor.conf with correct sensor endpoints and stream config.

set -e

UENV_SENSOR="/etc/uenv.sensor"
RAPTOR_CONF="/etc/raptor.conf"
LOG_TAG="gen-raptor-conf"

log() { logger -t "$LOG_TAG" "$*"; }

[ -f "$UENV_SENSOR" ] || { log "No sensor config found, skipping"; exit 0; }

. "$UENV_SENSOR" 2>/dev/null || exit 0

[ -n "$sensor_qty" ] || { log "No sensor_qty in $UENV_SENSOR"; exit 0; }

cat > "$RAPTOR_CONF" <<EOF
# Auto-generated by gen-raptor-conf from $UENV_SENSOR
# DO NOT EDIT MANUALLY — changes will be overwritten at boot

# Global stream settings
stream0_fps=15
stream1_fps=15

# Sensor 0 (main lens)
sensor0_name=${sensor0%%@*}
sensor0_i2c_addr=${sensor0#*@}
sensor0_fps=15

# RTSP endpoints
rtsp_endpoint_s0_main=ch0
rtsp_endpoint_s0_sub=ch1
EOF

if [ "$sensor_qty" -ge 2 ] && [ -n "$sensor1" ]; then
    cat >> "$RAPTOR_CONF" <<EOF

# Sensor 1 (secondary lens)
sensor1_name=${sensor1%%@*}
sensor1_i2c_addr=${sensor1#*@}
sensor1_fps=15

# S1 (second ISP) endpoints
rtsp_endpoint_s1_main=ch2
rtsp_endpoint_s1_sub=ch3
s1s0_fps=15
s1s1_fps=15
EOF
fi

log "Generated $RAPTOR_CONF for $sensor_qty sensor(s)"
exit 0