#!/bin/sh
# S15sensor-iq — Auto-select and load correct sensor IQ binary
# Based on detected sensor + ISP firmware version (commit 7daeef9 upstream)
# Loads IQ file to /usr/share/sensor/<sensor>-t23.bin

set -e

LOG_TAG="sensor-iq"
IQ_DIR="/usr/share/sensor"
UENV_SENSOR="/etc/uenv.sensor"
ISP_FW_VER_FILE="/proc/isp/firmware_version"  # if exposed by kernel

log() { logger -t "$LOG_TAG" "$*"; }

# Default IQ mapping: sensor_name -> iq_file
# Format: sensor_name:isp_version:iq_filename
# ISP version from kernel (e.g., 2.10, 2.20, 1.3.0)
declare -A IQ_MAP=(
    ["sc2336p:2.10"]="sc2336p-t23-2.10.bin"
    ["sc2336p:2.20"]="sc2336p-t23-2.20.bin"
    ["sc2336p:1.3.0"]="sc2336p-t23-1.3.0.bin"
    ["sc2336ps0:2.10"]="sc2336ps0-t23-2.10.bin"
    ["sc2336ps0:2.20"]="sc2336ps0-t23-2.20.bin"
    ["sc2336ps1:2.10"]="sc2336ps1-t23-2.10.bin"
    ["sc2336ps1:2.20"]="sc2336ps1-t23-2.20.bin"
    ["gc2053:2.10"]="gc2053-t23-2.10.bin"
    ["gc2053:2.20"]="gc2053-t23-2.20.bin"
    ["gc4653:2.10"]="gc4653-t23-2.10.bin"
    ["gc4653:2.20"]="gc4653-t23-2.20.bin"
    ["imx307:2.10"]="imx307-t23-2.10.bin"
    ["imx307:2.20"]="imx307-t23-2.20.bin"
)

# Read detected sensors from uenv
[ -f "$UENV_SENSOR" ] || { log "No sensor config, skipping IQ select"; exit 0; }
. "$UENV_SENSOR" 2>/dev/null || exit 0

# Get ISP firmware version (from kernel or default 2.10)
ISP_VER="2.10"
if [ -f "$ISP_FW_VER_FILE" ]; then
    ISP_VER=$(cat "$ISP_FW_VER_FILE" 2>/dev/null | tr -d '\n')
fi
log "ISP firmware version: $ISP_VER"

# Process each sensor
for sensor_var in sensor0 sensor1; do
    eval sensor_val="\$$sensor_var"
    [ -n "$sensor_val" ] || continue
    sensor_name="${sensor_val%%@*}"
    sensor_addr="${sensor_val#*@}"

    # Find matching IQ file
    iq_key="${sensor_name}:${ISP_VER}"
    iq_file="${IQ_MAP[$iq_key]}"
    [ -z "$iq_file" ] && iq_file="${IQ_MAP[$sensor_name:2.10]}"  # fallback
    [ -z "$iq_file" ] && { log "WARN: No IQ file for $sensor_name (ISP $ISP_VER)"; continue; }

    src="$IQ_DIR/$iq_file"
    dst="$IQ_DIR/${sensor_name}-t23.bin"  # canonical name expected by driver

    if [ -f "$src" ]; then
        cp -f "$src" "$dst"
        log "Loaded IQ: $src -> $dst for $sensor_name (ISP $ISP_VER)"
    else
        log "WARN: IQ file $src not found for $sensor_name"
    fi
done

log "Sensor IQ selection complete"
exit 0