#!/bin/sh
# S09motor-detect — Detect motor driver type (SPI WQ9001 vs GPIO) and load correct driver
# Runs after GPIO/SPI subsystems are up, before raptor/motor services

set -e

LOG_TAG="motor-detect"
MOTOR_FLAG="/etc/.motor-detected"
DRIVER_DIR="/usr/lib/modules/$(uname -r)"

log() { logger -t "$LOG_TAG" "$*"; }

# Skip if already done
[ -f "$MOTOR_FLAG" ] && exit 0

# Check for WQ9001 on SPI (TP-Link Tapo style)
if [ -e /sys/bus/spi/devices/spi0.0 ]; then
    modalias=$(cat /sys/bus/spi/devices/spi0.0/modalias 2>/dev/null)
    if echo "$modalias" | grep -qi "wq9001"; then
        log "Detected WQ9001 motor driver on SPI"
        insmod "$DRIVER_DIR/kernel/drivers/motor/wq9001.ko" 2>/dev/null || true
        echo "spi_wq9001" > /tmp/motor_type
        touch "$MOTOR_FLAG"
        log "Loaded WQ9001 motor driver"
        exit 0
    fi
fi

# Check for GPIO motor pins (classic pan/tilt)
# Typical pins: pan=GPIO59, tilt=GPIO50, ircut=GPIO51, etc.
if [ -e /sys/class/gpio/gpio59 ] || [ -e /sys/class/gpio/gpio50 ]; then
    log "Detected GPIO motor driver"
    insmod "$DRIVER_DIR/kernel/drivers/motor/motor.ko" 2>/dev/null || true
    echo "gpio" > /tmp/motor_type
    touch "$MOTOR_FLAG"
    log "Loaded GPIO motor driver"
    exit 0
fi

# No motor detected
log "No motor driver detected"
echo "none" > /tmp/motor_type
touch "$MOTOR_FLAG"
exit 0