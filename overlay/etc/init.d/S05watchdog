#!/bin/sh
# S05watchdog — Enable hardware watchdog (Ingenic T23 WDT)
# Kicks every 30s; if userspace hangs, hardware reboots cleanly.

set -e

WDT_DEV="/dev/watchdog"
KICK_INTERVAL=30
LOG_TAG="watchdog"

log() { logger -t "watchdog" "$*"; }

# Check watchdog device exists
[ -c "$WDT_DEV" ] || { log "Watchdog device $WDT_DEV not found"; exit 0; }

# Start watchdog daemon (busybox watchdog applet)
# -T = timeout (reset if not kicked within T seconds)
# -t = kick interval
# -F = run in foreground (we background it)
log "Starting hardware watchdog (timeout=${KICK_INTERVAL}s)"
watchdog -T $((KICK_INTERVAL + 5)) -t $KICK_INTERVAL -F "$WDT_DEV" &
WDT_PID=$!

# Trap signals to clean up
trap "kill $WDT_PID 2>/dev/null; exit 0" TERM INT

log "Watchdog started (pid=$WDT_PID, interval=${KICK_INTERVAL}s)"
wait $WDT_PID