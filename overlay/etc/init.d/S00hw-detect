#!/bin/sh
# S00hw-detect — Hardware inventory & compatibility check at early boot
# Runs before any drivers, writes /etc/hw-inventory.json
# Exits 0 on success, 1 on critical mismatch (halts boot with message)

set -e

LOG_TAG="hw-detect"
INVENTORY="/etc/hw-inventory.json"
EXPECTED="/etc/hw-expected.json"

log() { logger -t "$LOG_TAG" "$*"; }
die() { log "CRITICAL: $*"; echo "HW MISMATCH: $*" > /dev/console; exit 1; }
warn() { log "WARN: $*"; echo "HW WARN: $*" > /dev/console; }

# Expected values for Jooan W3-U (can be overridden by /etc/hw-expected.json)
EXP_FLASH_ID="c22017"      # MX25L6406E / compatible 64Mbit
EXP_RAM_MB=64
EXP_MAC_OUI="02:0b:f7"     # First 3 bytes of ethaddr
EXP_SENSOR_ADDRESSES="0x30 0x32"
EXP_MOTOR_TYPE="spi_wq9001"  # or "gpio"
EXP_WIFI_CHIP="atbm6132u"
EXP_ETH_PHY="rtl8201"      # or "internal"

# Load overrides if present
[ -f "$EXPECTED" ] && . "$EXPECTED" 2>/dev/null || true

# Helpers
read_jedec() {
    # Returns JEDEC ID as 6-hex string (e.g., c22017)
    sf probe >/dev/null 2>&1 || return 1
    sf read 0x80000000 0 3 >/dev/null 2>&1 || return 1
    # Note: actual read depends on U-Boot sf implementation
    # Fallback: use mtdinfo if available
    mtdinfo /dev/mtd0 2>/dev/null | grep -i "jedec" | head -1 | sed 's/.*0x\([0-9a-f]*\).*/\1/'
}

detect_flash() {
    local jedec
    jedec=$(read_jedec)
    if [ -z "$jedec" ] || [ ${#jedec} -lt 6 ]; then
        # Fallback: try mtd0 size
        local size
        size=$(cat /proc/mtd 2>/dev/null | awk '/^mtd0:/ {print $2}')
        [ "$size" = "00800000" ] && echo "size_ok" || echo "unknown"
    else
        echo "$jedec"
    fi
}

detect_ram() {
    # From kernel cmdline or /proc/meminfo
    awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo "0"
}

detect_mac_oui() {
    # From U-Boot env or factory partition
    fw_printenv -n ethaddr 2>/dev/null | cut -d: -f1-3 || echo "unknown"
}

detect_sensors() {
    local found=""
    for bus in 0 1; do
        for addr in 0x30 0x32 0x36 0x40 0x37; do
            if i2cget -y "$bus" "$addr" 0x00 >/dev/null 2>&1; then
                found="$found $addr"
            fi
        done
    done
    echo "$found" | xargs
}

detect_motor() {
    # Check for WQ9001 on SPI (typical Tapo/TP-Link) or GPIO motor pins
    if [ -e /sys/bus/spi/devices/spi0.0 ] && grep -q "wq9001" /sys/bus/spi/devices/spi0.0/modalias 2>/dev/null; then
        echo "spi_wq9001"
    elif [ -e /sys/class/gpio/gpio59 ] || [ -e /sys/class/gpio/gpio50 ]; then
        echo "gpio"
    else
        echo "none"
    fi
}

detect_wifi() {
    # Check for ATBM6132U
    if lsmod | grep -q "atbm6132u"; then
        echo "atbm6132u"
    elif [ -e /sys/bus/sdio/devices/mmc1:0001:1 ]; then
        echo "sdio_present"
    else
        echo "none"
    fi
}

detect_phy() {
    # Check Ethernet PHY
    if [ -e /sys/bus/mdio_bus/devices/*:00 ]; then
        local phy_id
        phy_id=$(cat /sys/bus/mdio_bus/devices/*:00/phy_id 2>/dev/null | head -1)
        case "$phy_id" in
            0x001cc816) echo "rtl8201" ;;
            0x00008201) echo "rtl8201" ;;
            *) echo "phy_$phy_id" ;;
        esac
    else
        echo "none"
    fi
}

check_pll() {
    # Quick check: try to read ISP/VPU clock registers via debugfs if available
    # For now, just log the kernel messages about CGU
    dmesg | grep -i "cgu_isp\|cgu_vpu\|cgu_cim" | head -3 | while read line; do
        log "CGU: $line"
    done
    return 0
}

# Main detection
log "Starting hardware inventory..."

FLASH_DETECT=$(detect_flash)
RAM_DETECT=$(detect_ram)
MAC_OUI_DETECT=$(detect_mac_oui)
SENSORS_DETECT=$(detect_sensors)
MOTOR_DETECT=$(detect_motor)
WIFI_DETECT=$(detect_wifi)
PHY_DETECT=$(detect_phy)

log "Flash: $FLASH_DETECT (expected ~$EXP_FLASH_ID)"
log "RAM: ${RAM_DETECT}MB (expected $EXP_RAM_MB)"
log "MAC OUI: $MAC_OUI_DETECT (expected $EXP_MAC_OUI)"
log "Sensors: $SENSORS_DETECT (expected $EXP_SENSOR_ADDRESSES)"
log "Motor: $MOTOR_DETECT (expected $EXP_MOTOR_TYPE)"
log "WiFi: $WIFI_DETECT (expected $EXP_WIFI_CHIP)"
log "PHY: $PHY_DETECT (expected $EXP_ETH_PHY)"

# Critical mismatches
[ "$RAM_DETECT" -ge 60 ] || die "RAM too low: ${RAM_DETECT}MB (need ≥60MB)"
[ "$FLASH_DETECT" = "size_ok" ] || [ "$FLASH_DETECT" = "$EXP_FLASH_ID" ] || warn "Flash ID mismatch: got $FLASH_DETECT, expected $EXP_FLASH_ID"

# MAC OUI check (first 3 bytes)
if [ "$MAC_OUI_DETECT" != "unknown" ] && [ "$MAC_OUI_DETECT" != "$EXP_MAC_OUI" ]; then
    warn "MAC OUI mismatch: got $MAC_OUI_DETECT, expected $EXP_MAC_OUI (may be re-flashed env)"
fi

# Sensor presence check
sensor_count=0
for addr in $SENSORS_DETECT; do
    sensor_count=$((sensor_count + 1))
done
[ $sensor_count -ge 1 ] || die "No sensors detected on I2C!"

# Write inventory JSON
cat > "$INVENTORY" <<EOF
{
  "timestamp": "$(date -Iseconds)",
  "hostname": "$(hostname)",
  "kernel": "$(uname -r)",
  "flash": {
    "jedec_id": "$FLASH_DETECT",
    "expected_jedec": "$EXP_FLASH_ID",
    "size_mb": 8
  },
  "ram_mb": $RAM_DETECT,
  "mac_oui": "$MAC_OUI_DETECT",
  "sensors_detected": "$SENSORS_DETECT",
  "sensor_count": $sensor_count,
  "motor_type": "$MOTOR_DETECT",
  "wifi_chip": "$WIFI_DETECT",
  "eth_phy": "$PHY_DETECT",
  "pll_check": "logged",
  "compatible": true
}
EOF

log "Hardware inventory written to $INVENTORY"
cat "$INVENTORY" | logger -t "$LOG_TAG"

# Run PLL check
check_pll

log "Hardware inventory complete — OK"
exit 0