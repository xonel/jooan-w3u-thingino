# t23-hw-validation.fragment — Kernel config for hardware validation features
# Enables debugfs, GPIO sysfs, I2C tools, SPI debug, watchdog, thermal, etc.

# Debug filesystem (required for hw-detect, self-test)
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_KERNEL=y

# GPIO support (sysfs interface for hw-detect)
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_GENERIC=y
CONFIG_GPIO_INGENIC=y

# I2C support (sensor detection)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_INGENIC=y

# SPI support (flash, motor driver)
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_INGENIC=y
CONFIG_SPI_BITBANG=y

# Watchdog
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_INGENIC_WDT=y

# Thermal / voltage monitoring
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_INGENIC_THERMAL=y

# HW random number generator
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INGENIC=y

# GPIO keys (button)
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# MMC/SD card
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SPI=y
CONFIG_MMC_INGENIC=y

# Ethernet PHY
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y

# USB (for recovery mode)
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_INGENIC_GADGET=y

# Sensors (V4L2 subdev)
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_V4L2_FWNODE=y

# Ingenic ISP
CONFIG_VIDEO_INGENIC_T23_ISP=y
CONFIG_VIDEO_INGENIC_T23_SENSOR_MULTI=y
CONFIG_VIDEO_INGENIC_T23_SENSOR_SC2336P=y
CONFIG_VIDEO_INGENIC_T23_SENSOR_SC2336PS0=y
CONFIG_VIDEO_INGENIC_T23_SENSOR_SC2336PS1=y
CONFIG_VIDEO_INGENIC_T23_SENSOR_GC2053=y
CONFIG_VIDEO_INGENIC_T23_SENSOR_GC4653=y
CONFIG_VIDEO_INGENIC_T23_SENSOR_IMX307=y

# Motor drivers
CONFIG_MOTOR_WQ9001=y
CONFIG_MOTOR_GPIO=y

# WiFi
CONFIG_ATBM6132U=y

# Debug
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_INFO=y